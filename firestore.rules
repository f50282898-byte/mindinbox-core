rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Function to check if user is an admin
    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // USERS COLLECTION
    match /users/{userId} {
      // User can read/write their own doc. Admins can read/write all.
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // Strict validation for updating own document (preventing users from making themselves admin)
      allow update: if isAuthenticated() && request.auth.uid == userId 
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'subscriptionTier', 'totalEarnings']));
      
      // USER SUB-COLLECTIONS (Journal)
      match /journalEntries/{entryId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
      
      // USER SUB-COLLECTIONS (Rewards)
      match /rewards/{rewardId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow write: if isAdmin(); // Only server/admin can write rewards
      }
    }
    
    // DAILY WISDOM COLLECTION
    match /dailyQuotes/{quoteId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // MASTERCLASSES COLLECTION (Media)
    match /masterclasses/{classId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}

